<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.badmintontest.controller.StockController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <center>
      <!-- รายการสินค้า มีหมายเลขข้างหน้า -->
      <TextArea fx:id="productArea" editable="false" />
   </center>
   <bottom>
      <VBox spacing="10.0">
         <children>
            <!-- เพิ่มสินค้าใหม่ -->
            <HBox spacing="10.0">
               <children>
                  <Label text="เพิ่มสินค้าใหม่: ชื่อ" />
                  <TextField fx:id="nameField" />
                  <Label text="ราคา" />
                  <TextField fx:id="priceField" prefWidth="70.0" />
                  <Label text="จำนวน" />
                  <TextField fx:id="stockField" prefWidth="70.0" />
                  <Button onAction="#onAddProductClick" text="เพิ่มสินค้า" />
               </children>
            </HBox>
            <!-- เติมสต็อกสินค้าเดิม -->
            <HBox spacing="10.0">
               <children>
                  <Label text="เติมสต็อก: หมายเลขสินค้า" />
                  <TextField fx:id="numberField" prefWidth="60.0" />
                  <Label text="จำนวนที่เติม" />
                  <TextField fx:id="addQtyField" prefWidth="70.0" />
                  <Button onAction="#onAddStockClick" text="เติมสต็อก" />
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
