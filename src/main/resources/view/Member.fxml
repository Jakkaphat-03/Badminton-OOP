<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.badmintontest.controller.MemberController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <top>
      <HBox spacing="10.0">
         <children>
            <Label text="ชื่อ" />
            <TextField fx:id="nameField" />
            <Label text="เบอร์โทร" />
            <TextField fx:id="phoneField" />
            <Button onAction="#onRegisterClick" text="สมัครสมาชิก (ใช้ได้ 1 ปี)" />
            <Button onAction="#onRefreshClick" text="รีเฟรช" />
         </children>
      </HBox>
   </top>
   <center>
      <!-- รายชื่อสมาชิกทั้งหมด -->
      <TextArea fx:id="memberArea" editable="false" />
   </center>
   <bottom>
      <HBox spacing="10.0">
         <children>
            <Label text="รหัสสมาชิก" />
            <TextField fx:id="packageMemberField" />
            <Button onAction="#onBuyPackageClick" text="ซื้อแพ็กเกจ 15 ชม. (2600 บาท ใช้ได้ 3 เดือน)" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
