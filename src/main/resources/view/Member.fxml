<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.badmintontest.controller.MemberController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <top>
      <HBox spacing="10.0">
         <children>
            <Label text="ชื่อ" />
            <TextField fx:id="nameField" />
            <Label text="เบอร์โทร" />
            <TextField fx:id="phoneField" />
            <Button onAction="#onRegisterClick" text="สมัครสมาชิก" />
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="memberTable">
         <columns>
            <TableColumn text="รหัส"><cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory></TableColumn>
            <TableColumn prefWidth="150.0" text="ชื่อ"><cellValueFactory><PropertyValueFactory property="name" /></cellValueFactory></TableColumn>
            <TableColumn prefWidth="100.0" text="เบอร์โทร"><cellValueFactory><PropertyValueFactory property="phone" /></cellValueFactory></TableColumn>
            <TableColumn prefWidth="110.0" text="ชม.ที่จองสะสม"><cellValueFactory><PropertyValueFactory property="totalHours" /></cellValueFactory></TableColumn>
            <TableColumn prefWidth="130.0" text="ชม.แพ็กเกจที่เหลือ"><cellValueFactory><PropertyValueFactory property="packageHoursLeft" /></cellValueFactory></TableColumn>
         </columns>
      </TableView>
   </center>
   <bottom>
      <HBox spacing="10.0">
         <children>
            <Label text="รหัสสมาชิก" />
            <TextField fx:id="packageMemberField" />
            <Button onAction="#onBuyPackageClick" text="ซื้อแพ็กเกจ 15 ชม. (2600 บาท)" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
