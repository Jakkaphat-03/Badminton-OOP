<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.badmintontest.controller.HistoryController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <top>
      <HBox spacing="10.0">
         <children>
            <Label text="รหัสสมาชิก (เช่น M1)" />
            <TextField fx:id="memberField" onAction="#onShowClick" />
            <Button onAction="#onShowClick" text="ดูประวัติ" />
            <Label fx:id="summaryLabel" />
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="bookingTable">
         <columns>
            <TableColumn text="รหัสจอง"><cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory></TableColumn>
            <TableColumn text="สนาม"><cellValueFactory><PropertyValueFactory property="court" /></cellValueFactory></TableColumn>
            <TableColumn text="วันที่เล่น"><cellValueFactory><PropertyValueFactory property="playDate" /></cellValueFactory></TableColumn>
            <TableColumn text="เวลา"><cellValueFactory><PropertyValueFactory property="timeText" /></cellValueFactory></TableColumn>
            <TableColumn text="ชั่วโมง"><cellValueFactory><PropertyValueFactory property="hours" /></cellValueFactory></TableColumn>
            <TableColumn text="ค่าสนาม"><cellValueFactory><PropertyValueFactory property="courtPrice" /></cellValueFactory></TableColumn>
            <TableColumn text="ค่าเช่า"><cellValueFactory><PropertyValueFactory property="rentPrice" /></cellValueFactory></TableColumn>
            <TableColumn text="รวม"><cellValueFactory><PropertyValueFactory property="amount" /></cellValueFactory></TableColumn>
            <TableColumn text="สลิป"><cellValueFactory><PropertyValueFactory property="slipPath" /></cellValueFactory></TableColumn>
         </columns>
      </TableView>
   </center>
</BorderPane>
