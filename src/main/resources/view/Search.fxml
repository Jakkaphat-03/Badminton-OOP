<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.badmintontest.controller.SearchController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <top>
      <VBox spacing="10.0">
         <children>
            <!-- ค้นหาจากชื่อหรือเบอร์โทร -->
            <HBox spacing="10.0">
               <children>
                  <Label text="ค้นหาจากชื่อหรือเบอร์โทร" />
                  <TextField fx:id="keywordField" onAction="#onSearchClick" />
                  <Button onAction="#onSearchClick" text="ค้นหา" />
               </children>
            </HBox>
            <!-- ค้นหาจากวันที่เล่น -->
            <HBox spacing="10.0">
               <children>
                  <Label text="ค้นหาจากวันที่เล่น" />
                  <DatePicker fx:id="searchDatePicker" />
                  <Button onAction="#onSearchDateClick" text="ค้นหาตามวันที่" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <!-- กล่องข้อความแสดงผลการค้นหา (แก้ไขข้อความไม่ได้) -->
      <TextArea fx:id="resultArea" editable="false" />
   </center>
   <bottom>
      <HBox spacing="10.0">
         <children>
            <Label text="รหัสจอง (เช่น B1)" />
            <TextField fx:id="bookingIdField" />
            <Button onAction="#onShowSlipClick" text="ดูสลิป" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
