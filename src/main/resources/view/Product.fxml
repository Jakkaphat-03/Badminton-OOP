<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.badmintontest.controller.ProductController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <center>
      <TableView fx:id="productTable">
         <columns>
            <TableColumn prefWidth="200.0" text="ชื่อสินค้า"><cellValueFactory><PropertyValueFactory property="name" /></cellValueFactory></TableColumn>
            <TableColumn text="ราคา"><cellValueFactory><PropertyValueFactory property="price" /></cellValueFactory></TableColumn>
            <TableColumn text="คงเหลือ"><cellValueFactory><PropertyValueFactory property="stock" /></cellValueFactory></TableColumn>
         </columns>
      </TableView>
   </center>
   <bottom>
      <HBox spacing="10.0">
         <children>
            <Label text="จำนวน" />
            <TextField fx:id="qtyField" text="1" />
            <Button onAction="#onSellClick" text="ขายสินค้าที่เลือก" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
