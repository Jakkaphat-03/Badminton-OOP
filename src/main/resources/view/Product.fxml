<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.badmintontest.controller.ProductController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <center>
      <!-- รายการสินค้า มีหมายเลขข้างหน้า -->
      <TextArea fx:id="productArea" editable="false" />
   </center>
   <bottom>
      <HBox spacing="10.0">
         <children>
            <Label text="หมายเลขสินค้า" />
            <TextField fx:id="numberField" prefWidth="60.0" />
            <Label text="จำนวน" />
            <TextField fx:id="qtyField" prefWidth="60.0" text="1" />
            <Label text="รหัสสมาชิก (ถ้ามี ลด 5%)" />
            <TextField fx:id="memberField" prefWidth="80.0" />
            <Button onAction="#onSellClick" text="ขายสินค้า" />
            <Button onAction="#onRefreshClick" text="รีเฟรช" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
